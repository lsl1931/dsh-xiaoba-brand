{
  "name": "dsh-xiaoba-brand",
  "version": "0.1.0",
  "description": "DSH Web 品牌替换插件：把侧栏与欢迎页的 DeepSeek 标志替换为自定义形象与字标，并改写 hero 文案。所有项均可通过 cordis.patch.yml 配置。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node tools/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "brand",
    "white-label",
    "wordmark"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsl1931/dsh-xiaoba-brand.git"
  },
  "homepage": "https://github.com/lsl1931/dsh-xiaoba-brand#readme",
  "bugs": {
    "url": "https://github.com/lsl1931/dsh-xiaoba-brand/issues"
  }
}
